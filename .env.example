# JWT_SECRET: Secret for signing JWT tokens.
JWT_SECRET="MY_JWT_SECRET"

# Seed account passwords (used only when an account is first created).
# Set real values in .env (git-ignored). If unset, the server generates a
# random one-time password so no usable default credential ships in source.
ADMIN_SEED_PASSWORD="CHANGE_ME_admin"
ANALYST_SEED_PASSWORD="CHANGE_ME_analyst"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SMTP/email notification integration.
# SMTP_PROVIDER can be gmail, office365, or custom.
# For office365, the recommended auth method is Microsoft Graph OAuth.
SMTP_PROVIDER="office365"
MS365_TENANT_ID="00000000-0000-0000-0000-000000000000"
MS365_CLIENT_ID="00000000-0000-0000-0000-000000000000"
MS365_CLIENT_SECRET="CHANGE_ME_azure_client_secret"
MS365_MAILBOX="aisoc@example.com"
ALERT_EMAIL_TO="soc-team@example.com"

# Gmail/custom SMTP fallback:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="aisoc@example.com"
# SMTP_PASS="CHANGE_ME_smtp_password_or_app_password"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
