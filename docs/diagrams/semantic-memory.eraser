title Semantic Memory - pgvector RAG Loop

Inputs [icon: log-in, color: gray] {
  ALERT  [icon: alert-triangle, label: "Incoming alert\n(description + log)"]
  INCID  [icon: flag,           label: "Resolved incident\n(insight to remember)"]
}

Embedding [icon: sparkles, color: orange] {
  OLLAMA [icon: box,    label: "Ollama /api/embeddings\n(nomic-embed-text)"]
  VEC    [icon: hash,   label: "Float32 vector (768-d)"]
  DEGRADE [icon: alert-octagon, label: "null → graceful skip\n(Ollama unreachable)"]
}

PostgreSQL Memory Store [icon: database, color: purple] {
  POOL   [icon: plug,        label: "shared pg pool\ndb/pool.ts"]
  TABLE  [icon: file-search, label: "incident_insights\nsummary · TTPs · outcome"]
  COL    [icon: save,        label: "embedding vector(768)\npgvector column"]
  HNSW   [icon: list-tree,   label: "HNSW cosine index\nvector_cosine_ops"]
}

Retrieval [icon: search, color: blue] {
  QEMBED [icon: sparkles,    label: "Embed query"]
  ANN    [icon: git-compare, label: "SQL semantic search\nORDER BY embedding <=> q"]
  TOPK   [icon: filter,      label: "Top-k ≥ threshold\n1 - (embedding <=> q)\n(recallHits)"]
}

Augment + Generate [icon: brain, color: green] {
  CTX    [icon: book-open,    label: "Inject as context\n(priorFpInsights · memoryFpHint)"]
  TRIAGE [icon: brain-circuit, label: "Triage LLM\n(analysis node)"]
  VERDICT [icon: badge-check, label: "Verdict\n(FP signal / risk)"]
}

// ── Write path (remember a past incident) ──
INCID > OLLAMA: commitAsync
OLLAMA > VEC
OLLAMA > DEGRADE: no response
VEC > COL: pgvector literal
POOL > TABLE: INSERT
TABLE > COL
COL > HNSW: indexed

// ── Read path (retrieve at triage time) ──
ALERT > QEMBED
QEMBED > OLLAMA
QEMBED > ANN: query vector literal
POOL > ANN: SELECT
HNSW > ANN: nearest-neighbour
ANN > TOPK
TOPK > CTX
CTX > TRIAGE
ALERT > TRIAGE: raw alert
TRIAGE > VERDICT
