title Memory System

Stores [icon: database, color: purple] {
  T_INSIGHT [icon: file-search, label: "Insights\n(semantic + embedding)"]
  T_IOC     [icon: hash,        label: "IOC memory"]
  T_ASSET   [icon: server,      label: "Asset context"]
  T_SUPP    [icon: filter,      label: "Suppression rules"]
  T_WORK    [icon: list-tree,   label: "Working memory"]
}

Reads (pre-flight) [icon: search, color: orange] {
  R_RECALL [icon: history, label: "Recall search"]
  R_IOC    [icon: hash,    label: "IOC lookup"]
  R_ASSET  [icon: server,  label: "Asset lookup"]
  R_SUPP   [icon: filter,  label: "Suppression match"]
}

Writes [icon: upload, color: blue] {
  W_IOC     [icon: refresh-cw, label: "Upsert IOCs\n(sync)"]
  W_INSIGHT [icon: zap,        label: "Commit insight\n(async + embed)"]
  W_WORK    [icon: pen-tool,   label: "Planner trace"]
}

Orchestrator [icon: cpu, color: red] {
  S0 [icon: filter,    label: "Suppression"]
  S1 [icon: search,    label: "Pre-flight"]
  S4 [icon: brain,     label: "Planner"]
  S7 [icon: upload,    label: "Commit"]
}

UI APIs [icon: webhook, color: teal] {
  API [icon: book-open, label: "Memory APIs\n(insights · IOCs · assets · rules)"]
}

Learning [icon: lightbulb, color: yellow] {
  SUGG  [icon: lightbulb,   label: "FP suggestion"]
  ADMIN [icon: user-check,  label: "Admin approves"]
  NEW   [icon: plus-circle, label: "New rule"]
}

S0 > R_SUPP
R_SUPP > T_SUPP
S1 > R_RECALL
S1 > R_IOC
S1 > R_ASSET
R_RECALL > T_INSIGHT
R_IOC > T_IOC
R_ASSET > T_ASSET
S4 > W_WORK
W_WORK > T_WORK
S7 > W_IOC
S7 > W_INSIGHT
W_IOC > T_IOC
W_INSIGHT > T_INSIGHT
T_INSIGHT > API
T_IOC > API
T_ASSET > API
T_SUPP > API
T_IOC > SUGG
SUGG > ADMIN
ADMIN > NEW
NEW > T_SUPP
