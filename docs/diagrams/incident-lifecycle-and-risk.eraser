title Incident Lifecycle

Bridge [icon: alert-octagon, color: red] {
  ALERT  [icon: siren,    label: "Escalated alert"]
  CREATE [icon: workflow, label: "Create incident"]
}

Phases [icon: route, color: blue] {
  P_DET  [icon: search,     label: "Detection"]
  P_ANA  [icon: microscope, label: "Analysis"]
  P_CON  [icon: shield,     label: "Containment"]
  P_ERA  [icon: bug,        label: "Eradication"]
  P_REC  [icon: wrench,     label: "Recovery"]
  P_POST [icon: file-check, label: "Post-incident"]
}

Status [icon: activity, color: orange] {
  OPEN   [icon: circle,       label: "OPEN"]
  PROG   [icon: loader,       label: "IN_PROGRESS"]
  CONT   [icon: shield-check, label: "CONTAINED"]
  RES    [icon: check-circle, label: "RESOLVED"]
  CLOSED [icon: lock,         label: "CLOSED"]
}

Actions [icon: list-checks, color: teal] {
  A_PEND [icon: clock,       label: "Pending"]
  A_APPR [icon: thumbs-up,   label: "Approved"]
  A_EXEC [icon: play-circle, label: "Executed"]
}

Metrics [icon: gauge, color: green] {
  M_ACTIVE [icon: bell,        label: "Active count"]
  M_MTTR   [icon: timer,       label: "MTTR"]
  M_FP     [icon: percent,     label: "FP rate"]
  M_AUTO   [icon: cpu,         label: "Automation rate"]
}

ALERT > CREATE
CREATE > OPEN
CREATE > A_PEND
OPEN > PROG: assigned
PROG > P_DET
P_DET > P_ANA
P_ANA > P_CON
P_CON > P_ERA
P_ERA > P_REC
P_REC > CONT
CONT > P_POST
P_POST > RES
RES > CLOSED
A_PEND > A_APPR
A_APPR > A_EXEC
OPEN > M_ACTIVE
PROG > M_ACTIVE
CLOSED > M_MTTR
CLOSED > M_AUTO
CLOSED > M_FP
