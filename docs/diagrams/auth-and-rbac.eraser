title Authentication & RBAC

Clients [icon: users, color: red] {
  HUMAN [icon: user,   label: "Analyst"]
  SIEM  [icon: server, label: "SIEM / agent"]
}

Login [icon: log-in, color: orange] {
  LDAP   [icon: search, label: "LDAP / AD bind"]
  LOCAL  [icon: key,    label: "Local bcrypt"]
  LOCK   [icon: lock,   label: "Lockout check\n(5 fails / 15 min)"]
  JWT    [icon: badge,  label: "Issue JWT"]
}

Step-Up [icon: shield, color: pink] {
  REAUTH [icon: lock, label: "Re-auth\n(sensitive ops)"]
  STEP   [icon: key,  label: "Step-up token\n(5 min)"]
}

Guards [icon: filter, color: blue] {
  AUTHN [icon: key,    label: "Authenticate"]
  RBAC  [icon: scale,  label: "Role gate"]
  ADMIN [icon: shield, label: "Admin gate"]
}

Roles [icon: layers, color: purple] {
  TIER1 [icon: user-check, label: "TIER1"]
  TIER2 [icon: user-check, label: "TIER2"]
  LEAD  [icon: users,      label: "INCIDENT_LEAD"]
  ADM   [icon: shield,     label: "ADMIN"]
}

Admin Ops [icon: shield, color: yellow] {
  USERS  [icon: user-plus, label: "User management"]
  AI     [icon: cpu,       label: "AI models"]
  SYS    [icon: server,    label: "System ops"]
}

Audit [icon: clipboard, color: green] {
  WRITE [icon: pen-tool, label: "writeAudit()"]
  LOGS  [icon: file-text, label: "audit_logs"]
}

API Keys [icon: key, color: teal] {
  KEY [icon: key, label: "X-Api-Key\n(machine ingest)"]
}

HUMAN > LDAP
HUMAN > LOCAL
SIEM > KEY
LDAP > JWT
LOCAL > LOCK
LOCK > JWT
JWT > AUTHN
AUTHN > RBAC
AUTHN > ADMIN
RBAC > TIER1
RBAC > TIER2
RBAC > LEAD
ADMIN > ADM
ADMIN > USERS
ADMIN > AI
ADMIN > SYS
USERS > REAUTH
AI > REAUTH
SYS > REAUTH
REAUTH > STEP
STEP > WRITE
JWT > WRITE
LOCK > WRITE
WRITE > LOGS
