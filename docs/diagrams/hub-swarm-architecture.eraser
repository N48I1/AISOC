title Hub-and-Swarm Orchestration

Entry [icon: power, color: red] {
  ALERT [icon: alert-triangle, label: "Alert"]
}

Hub [icon: brain, color: orange] {
  S0 [icon: filter,        label: "Suppression check"]
  S1 [icon: search,        label: "Pre-flight reads\n(recall · IOCs · assets)"]
  S2 [icon: activity,      label: "Triage LLM"]
  S3 [icon: scale,         label: "FP short-circuit?"]
  S4 [icon: brain-circuit, label: "Planner LLM"]
}

Workers (parallel) [icon: cpu, color: blue] {
  W_INTEL [icon: radar,     label: "Intel"]
  W_KNOW  [icon: book-open, label: "Knowledge"]
  W_CORR  [icon: network,   label: "Correlation"]
  W_MEM   [icon: history,   label: "Recall + IOC"]
}

Composers (sequential) [icon: layers, color: teal] {
  C_TICKET [icon: file-text,    label: "Ticketing"]
  C_RESP   [icon: shield-check, label: "Response"]
  C_VALID  [icon: badge-check,  label: "Validation"]
}

Finalize [icon: flag, color: purple] {
  AGG    [icon: calculator, label: "FP aggregator"]
  GATE   [icon: gauge,      label: "Priority gate"]
  COMMIT [icon: upload,     label: "Memory commit"]
  OUT    [icon: monitor,    label: "Return result"]
}

ALERT > S0
S0 > S1
S1 > S2
S2 > S3
S3 > COMMIT: FP confirmed
S3 > S4: continue
S4 > W_INTEL
S4 > W_KNOW
S4 > W_CORR
S4 > W_MEM
W_INTEL > C_TICKET
W_KNOW > C_TICKET
W_CORR > C_TICKET
W_MEM > C_TICKET
C_TICKET > C_RESP
C_RESP > C_VALID
C_VALID > AGG
AGG > GATE
GATE > COMMIT
COMMIT > OUT
